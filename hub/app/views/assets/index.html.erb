<% if defined?(@error) && @error %>
  <div class="error-box"><%= @error %></div>
<% end %>

<div class="card" data-controller="search"
     data-search-url-value="/assets"
     data-search-min-length-value="2"
     data-search-delay-value="300">
  <div class="card-title">Asset Browser</div>

  <div style="margin-bottom: 1rem; position: relative;">
    <input type="text"
           data-search-target="input"
           data-action="input->search#search"
           placeholder="Search assets by name or path..."
           value="<%= params[:q] %>"
           style="width: 100%; padding: 0.6rem 1rem; padding-right: 2.5rem; background: var(--bg-dark); border: 1px solid var(--border-color);
                  border-radius: 8px; color: var(--text-primary); font-family: 'JetBrains Mono', monospace; font-size: 0.85rem;
                  outline: none;">
    <% if params[:q].present? %>
      <button data-action="search#clear"
              style="position: absolute; right: 0.5rem; top: 50%; transform: translateY(-50%);
                     background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 1rem;">
        ✕
      </button>
    <% end %>
  </div>

  <% counts = @counts || {"ok" => 0, "pending" => 0, "error" => 0} %>
  <div class="filter-bar" data-controller="filter">
    <a href="/assets" data-filter-target="link" data-action="filter#select"
       class="<%= 'active' unless @status_filter.present? %>">All (<%= counts.values.sum %>)</a>
    <a href="/assets?status=ok" data-filter-target="link" data-action="filter#select"
       class="<%= 'active' if @status_filter == 'ok' %>">✓ OK (<%= counts["ok"] || 0 %>)</a>
    <a href="/assets?status=pending" data-filter-target="link" data-action="filter#select"
       class="<%= 'active' if @status_filter == 'pending' %>">⋯ Pending (<%= counts["pending"] || 0 %>)</a>
    <a href="/assets?status=error" data-filter-target="link" data-action="filter#select"
       class="<%= 'active' if @status_filter == 'error' %>">✗ Errors (<%= counts["error"] || 0 %>)</a>
  </div>

  <div data-search-target="results">
    <div id="asset-table">
      <%= render partial: "asset_table", locals: { assets: @assets || [], error: @error } %>
    </div>
  </div>
</div>
