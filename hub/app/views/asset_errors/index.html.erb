<% if defined?(@error) && @error %>
  <div class="error-box"><%= @error %></div>
<% end %>

<div class="card">
  <div class="card-title">Asset Errors</div>

  <% if @errors.any? %>
    <table>
      <thead>
        <tr>
          <th>Type</th>
          <th>Asset</th>
          <th>Message</th>
          <th>Run</th>
          <th>Timestamp</th>
        </tr>
      </thead>
      <tbody>
        <% @errors.each do |err| %>
          <tr>
            <td><span class="badge error"><%= err["error_type"] %></span></td>
            <td class="asset-path mono"><%= err["relative_path"] %></td>
            <td>
              <div class="error-message"><%= err["message"].to_s.truncate(80) %></div>
            </td>
            <td><span class="run-id"><%= err["run_id"].to_s[0..8] %>…</span></td>
            <td style="color: var(--text-muted); font-size: 0.8rem;">
              <%= Time.parse(err["timestamp"]).strftime("%H:%M:%S") rescue err["timestamp"] %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p style="color: var(--text-muted); text-align: center; padding: 2rem;">
      <span style="color: #22c55e; font-size: 2rem;">✓</span><br>
      No errors recorded. Pipeline is clean.
    </p>
  <% end %>
</div>
